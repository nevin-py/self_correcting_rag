# ==============================================================================
# 1. CORE API & SECURITY CONFIGURATION
# ==============================================================================
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# ==============================================================================
# 2. RELATIONAL DATABASE (POSTGRESQL)
# ==============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database_name
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/self_correcting_rag

# ==============================================================================
# 3. AI & LANGUAGE MODEL CONFIGURATION
# ==============================================================================
GROQ_KEY=your_groq_api_key_here
NOMIC_API_KEY=your_nomic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# 4. EXTERNAL AGENT TOOLS & FALLBACK SEARCH
# ==============================================================================
TAVILY_API_KEY=your_tavily_api_key_here
SEARXNG_URL=http://localhost:8888  # Local SearXNG instance (meta-search engine)
CHUNK_SIZE=2048
CHUNK_OVERLAP=256

# ==============================================================================
# 5. OPENROUTER (FALLBACK WHEN GROQ HITS RATE LIMITS)
# Get your API key at: https://openrouter.ai/keys
# ==============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_PLANNER_MODEL=xiaomi/mimo-v2.5
OPENROUTER_GENERATOR_MODEL=anthropic/claude-haiku-4.5

# ==============================================================================
# 6. EMBEDDING RATE LIMITS
# Nomic Embedding API: 1200 requests / 5-min rolling window / IP
# Defaults: concurrency=2, interval=0.25s → 4 req/s, well under limit
# ==============================================================================
NOMIC_CONCURRENCY=2
NOMIC_INTERVAL=0.5
NOMIC_MAX_RETRIES=3

# ==============================================================================
# 6. GRAPH EXECUTION GUARDS
# ==============================================================================
MAX_GRAPH_STEPS=15
MAX_SEARCHES=3
MAX_RETRIEVALS=4
MAX_REGENERATIONS=3
