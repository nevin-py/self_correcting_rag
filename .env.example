# ==============================================================================
# 1. CORE API & SECURITY CONFIGURATION
# ==============================================================================
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=your_super_secret_random_hex_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# ==============================================================================
# 2. RELATIONAL DATABASE (POSTGRESQL)
# ==============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database_name
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/self_correcting_rag

# ==============================================================================
# 3. AI & LANGUAGE MODEL CONFIGURATION
# ==============================================================================
GROQ_KEY=your_groq_api_key_here
NOMIC_API_KEY=your_nomic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# 4. EXTERNAL AGENT TOOLS & FALLBACK SEARCH
# ==============================================================================
TAVILY_API_KEY=your_tavily_api_key_here
CHUNK_SIZE=500
CHUNK_OVERLAP=50
