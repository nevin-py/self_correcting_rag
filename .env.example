# ==============================================================================
# 1. CORE API & SECURITY CONFIGURATION
# ==============================================================================
# Generate a secure key: openssl rand -hex 32
# Never commit real secrets. Personal OpenRouter/Google/Groq keys belong in
# each user's Settings UI (encrypted) or a private untracked .env — not in git.
SECRET_KEY=your_secret_key_here
# Dedicated key for encrypting per-user provider API keys at rest (Fernet).
# REQUIRED in production — must differ from SECRET_KEY. Generate:
#   openssl rand -hex 32
# Rotating SECRET_KEY does NOT affect stored user keys once this is set.
ENCRYPTION_KEY=  # openssl rand -hex 32 (dedicated; NOT the same as SECRET_KEY)
ALGORITHM=HS256
# Behind Caddy / Cloud Run / a reverse proxy: rate limits key on the
# X-Forwarded-For client IP instead of the proxy IP. Only enable when the
# proxy overwrites this header.
TRUST_PROXY_HEADERS=false
# Rate-limit storage: in-memory by default (per-process). With multiple
# workers/instances use Redis so limits are enforced globally:
RATELIMIT_STORAGE_URI=
# Production: prefer short access TTL (e.g. 15) + refresh rotation
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ENVIRONMENT=development
# Production: comma-separated frontend origins (required when ENVIRONMENT=production)
CORS_ORIGINS=http://localhost:3000
SQL_ECHO=false

# Docker / Postgres (used by docker-compose*.yml)
POSTGRES_USER=ariva
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=self_correcting_rag
SEARXNG_SECRET=change_me_searxng_secret
# Prod Caddy: DOMAIN=api.example.com  ACME_EMAIL=you@example.com
# Local HTTP-only prod smoke: DOMAIN=:80
DOMAIN=
ACME_EMAIL=
UVICORN_WORKERS=2

# ==============================================================================
# 2. RELATIONAL DATABASE (POSTGRESQL)
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/self_correcting_rag

# ==============================================================================
# 3. EMAIL (OTP verification + password reset)
# Render's free tier BLOCKS outbound SMTP — set EMAIL_BACKEND=brevo there.
# Brevo needs NO domain: verify your sender address once at
# brevo.com → Senders & IP, then set BREVO_FROM to that exact address.
# ==============================================================================
EMAIL_BACKEND=brevo
BREVO_API_KEY=
BREVO_FROM=you@example.com

# Optional alternative backends:
#  - smtp (default local): needs SMTP_* below; blocked on Render free tier
#  - resend: like brevo but requires a verified DOMAIN for sending to
#    anyone (the sandbox sender only reaches your own account email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true
SMTP_TIMEOUT_SECONDS=5
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ==============================================================================
# 4. QUOTAS / ANTI-SPAM
# ==============================================================================
MAX_CHATS_PER_USER=20
MAX_CHAT_CREATES_PER_HOUR=10
MAX_QUERIES_PER_HOUR=30
MAX_INGEST_TOKENS_PER_DAY=500000
MAX_TAVILY_CALLS_PER_DAY=50
MAX_FILE_TOKENS=200000
UPLOAD_DIR=data/uploads
MAX_CHUNKS_PER_FILE=500

# ==============================================================================
# 5. AI & LANGUAGE MODEL CONFIGURATION (optional server defaults)
# Users can override OpenRouter / Google / Groq keys in Settings.
# Tavily + Nomic stay system-only.
# ==============================================================================
GROQ_KEY=your_groq_api_key_here
NOMIC_API_KEY=your_nomic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your_openai_api_key_here

GOOGLE_AI_API_KEY=your_google_ai_studio_key_here
GOOGLE_AI_PLANNER_MODEL=gemini-2.5-flash
GOOGLE_AI_GENERATOR_MODEL=gemini-2.5-flash
GOOGLE_AI_HALLUCINATION_MODEL=gemini-2.5-flash

# ==============================================================================
# 6. EXTERNAL AGENT TOOLS & FALLBACK SEARCH (system-only)
# ==============================================================================
TAVILY_API_KEY=your_tavily_api_key_here
SEARXNG_URL=http://localhost:8888
CHUNK_SIZE=2048
CHUNK_OVERLAP=256

# ==============================================================================
# 7. OPENROUTER (optional server default)
# ==============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_GENERATOR_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_HALLUCINATION_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ==============================================================================
# 8. EMBEDDING RATE LIMITS
# ==============================================================================
NOMIC_CONCURRENCY=2
NOMIC_INTERVAL=0.5
NOMIC_MAX_RETRIES=3

# ==============================================================================
# 9. GRAPH EXECUTION GUARDS
# ==============================================================================
MAX_GRAPH_STEPS=20
MAX_SEARCHES=3
MAX_RETRIEVALS=4
MAX_REGENERATIONS=3
QUERY_TIMEOUT_SECONDS=0
USE_VERIFY_CASCADE=true
MAX_REPAIR_PASSES=1

# ── Reranking (memory/latency tuning) ────────────────────────────────────
# openrouter = free Nemotron rerank API (zero RAM; ~1-4s; falls back to
#              FlashRank on error/rate-limit). flashrank = local ONNX.
RERANK_BACKEND=openrouter
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
RERANK_MAX_PASSAGES=60
RERANK_TIMEOUT=12
FLASHRANK_CACHE_DIR=/tmp/flashrank

# Shared HTTP client pool + bounded full-page enrichment (RAM guard)
HTTPX_MAX_CONNECTIONS=20
ENRICHMENT_CONCURRENCY=4

# Async DB pool caps (Supabase pooler URLs use NullPool regardless)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
